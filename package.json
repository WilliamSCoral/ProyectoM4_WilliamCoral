{
  "name": "gestor-estrategico-tareas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Gestor estrategico de tareas - SPA con React, TypeScript, Firebase (Auth + Firestore), AWS SES y despliegue en Vercel. Proyecto Integrador M4 - Henry.",
  "scripts": {
    "dev": "vite",
    "dev:functions": "vercel dev",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.1119.0",
    "firebase": "^10.14.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^26.4.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vercel/node": "^8.1.2",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^24.1.1",
    "typescript": "^5.5.3",
    "vercel": "^59.7.0",
    "vite": "^5.4.1",
    "vitest": "^2.0.5"
  }
}
