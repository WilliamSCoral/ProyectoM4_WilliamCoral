# -----------------------------------------------------------------------
# Plantilla de variables de entorno. Copiar este archivo como ".env" y
# completar con valores reales. El archivo ".env" NUNCA se sube al repo
# (ver .gitignore).
# -----------------------------------------------------------------------

# --- Firebase (frontend) ---
# Se obtienen en Firebase Console > Configuración del proyecto > Tus apps.
# Deben empezar con VITE_ para que Vite las exponga al navegador.
# Se configuran en el Hito 2.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# --- AWS SES (solo backend / Vercel Functions en api/) ---
# IMPORTANTE: estas variables NO llevan prefijo VITE_ a propósito.
# Si llevaran VITE_, Vite las incluiría en el bundle del navegador y
# quedarían expuestas. Solo las lee api/send-email.ts (nunca el frontend).
# Se configuran en el Hito 7.
# AWS_REGION debe ser la MISMA región donde verificaste las identidades
# en SES Console (ej: us-east-1) o el envío falla con "Identity not found".
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
# Email verificado en SES Console (Verified identities) que figura como
# remitente ("From") del email.
SES_SOURCE_EMAIL=
